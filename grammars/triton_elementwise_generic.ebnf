root ::= imports module_gap elementwise_module

elementwise_module ::= binary_module | unary_module | relu_sqrt_module

imports ::= "import torch\nimport triton\nimport triton.language as tl\n"
module_gap ::= "\n\n"

pid_line ::= "    pid = tl.program_id(0)\n"
offsets_line ::= "    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n"
mask_line ::= "    mask = offsets < n_elements\n"
load_x_line ::= "    x = tl.load(input_ptr + offsets, mask=mask, other=0.0)\n"
load_y_line ::= "    y = tl.load(other_ptr + offsets, mask=mask, other=0.0)\n"
store_result_line ::= "    tl.store(output_ptr + offsets, result, mask=mask)\n"

block_size ::= "128" | "256" | "512" | "1024"

binary_module ::= binary_kernel module_gap binary_wrapper
unary_module ::= unary_kernel module_gap unary_wrapper
relu_sqrt_module ::= relu_sqrt_kernel module_gap relu_sqrt_wrapper

binary_public_name ::= "add" | "sub"
unary_public_name ::= "sqrt" | "rsqrt" | "tanh"

binary_operator ::= "+" | "-"
binary_expr ::= "x " binary_operator " alpha * y"
unary_expr ::= "tl.sqrt(x)" | "tl.rsqrt(x)" | "2.0 / (1.0 + tl.exp(-2.0 * x)) - 1.0"

binary_kernel ::= "@triton.jit\n"
                  "def _binary_elementwise_kernel(input_ptr, other_ptr, output_ptr, n_elements, alpha: tl.constexpr, BLOCK_SIZE: tl.constexpr):\n"
                  pid_line
                  offsets_line
                  mask_line
                  load_x_line
                  load_y_line
                  "    result = " binary_expr "\n"
                  store_result_line

unary_kernel ::= "@triton.jit\n"
                 "def _unary_elementwise_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
                 pid_line
                 offsets_line
                 mask_line
                 load_x_line
                 "    result = " unary_expr "\n"
                 store_result_line

relu_sqrt_kernel ::= "@triton.jit\n"
                     "def _relu_sqrt_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n"
                     pid_line
                     offsets_line
                     mask_line
                     load_x_line
                     "    relu = tl.maximum(x, 0.0)\n"
                     "    result = tl.sqrt(relu)\n"
                     store_result_line

binary_wrapper_prefix ::= "    if out is None:\n"
                          "        output = torch.empty_like(input)\n"
                          "    else:\n"
                          "        output = out\n"
                          "    n_elements = input.numel()\n"
                          "    if n_elements == 0:\n"
                          "        return output\n"
                          "    if torch.is_tensor(other):\n"
                          "        other_tensor = other.contiguous()\n"
                          "    else:\n"
                          "        other_tensor = torch.full_like(input, other)\n"
                          "    input_contig = input.contiguous()\n"
                          "    grid = lambda meta: (triton.cdiv(n_elements, meta['BLOCK_SIZE']),)\n"

unary_wrapper_prefix ::= "    if out is None:\n"
                         "        output = torch.empty_like(input)\n"
                         "    else:\n"
                         "        output = out\n"
                         "    n_elements = input.numel()\n"
                         "    if n_elements == 0:\n"
                         "        return output\n"
                         "    input_contig = input.contiguous()\n"
                         "    grid = lambda meta: (triton.cdiv(n_elements, meta['BLOCK_SIZE']),)\n"

relu_sqrt_wrapper_prefix ::= "    if input.dtype != torch.float32 and input.dtype != torch.float64:\n"
                             "        result = torch.sqrt(torch.relu(input.float()))\n"
                             "        if out is not None:\n"
                             "            out.copy_(result)\n"
                             "            return out\n"
                             "        return result\n"
                             "    if inplace:\n"
                             "        output = input\n"
                             "    elif out is None:\n"
                             "        output = torch.empty_like(input)\n"
                             "    else:\n"
                             "        output = out\n"
                             "    n_elements = input.numel()\n"
                             "    if n_elements == 0:\n"
                             "        return output\n"
                             "    input_contig = input.contiguous()\n"
                             "    grid = lambda meta: (triton.cdiv(n_elements, meta['BLOCK_SIZE']),)\n"

return_output ::= "    return output\n"

binary_wrapper ::= "def " binary_public_name "(input, other, *, alpha=1, out=None):\n"
                   binary_wrapper_prefix
                   "    _binary_elementwise_kernel[grid](input_contig, other_tensor, output, n_elements, alpha, BLOCK_SIZE=" block_size ")\n"
                   return_output

unary_wrapper ::= "def " unary_public_name "(input, *, out=None):\n"
                  unary_wrapper_prefix
                  "    _unary_elementwise_kernel[grid](input_contig, output, n_elements, BLOCK_SIZE=" block_size ")\n"
                  return_output

relu_sqrt_wrapper ::= "def relu_sqrt(input, inplace=False, out=None):\n"
                      relu_sqrt_wrapper_prefix
                      "    _relu_sqrt_kernel[grid](input_contig, output, n_elements, BLOCK_SIZE=" block_size ")\n"
                      return_output
