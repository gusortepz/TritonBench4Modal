digraph G {
  rankdir=LR; bgcolor="white";
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11];
  start [shape=point];
  I1 [shape=doublecircle, xlabel="NAME / keyword"];
  S0 [shape=circle];
  start -> S0;
  S0 -> I1 [label="letter, _"];
  I1 -> I1 [label="letter, digit, _"];
}