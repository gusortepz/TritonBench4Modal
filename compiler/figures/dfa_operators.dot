digraph G {
  rankdir=LR; bgcolor="white";
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11];
  start [shape=point];
  E1 [shape=doublecircle, xlabel="ASSIGN"];
  E2 [shape=doublecircle, xlabel="EQUAL_EQUAL"];
  H1 [shape=doublecircle, xlabel="MINUS"];
  H2 [shape=doublecircle, xlabel="MINUS_ASSIGN"];
  H3 [shape=doublecircle, xlabel="ARROW"];
  K1 [shape=doublecircle, xlabel="delimiter token"];
  L1 [shape=doublecircle, xlabel="LESS"];
  L2 [shape=doublecircle, xlabel="LESS_EQUAL"];
  L3 [shape=doublecircle, xlabel="LEFT_SHIFT"];
  L4 [shape=doublecircle, xlabel="LEFT_SHIFT_ASSIGN"];
  M1 [shape=doublecircle, xlabel="STAR"];
  M2 [shape=doublecircle, xlabel="DOUBLE_STAR"];
  M3 [shape=doublecircle, xlabel="STAR_ASSIGN"];
  M4 [shape=doublecircle, xlabel="DOUBLE_STAR_ASSIGN"];
  O1 [shape=doublecircle, xlabel="PLUS, AMPERSAND, ..."];
  O2 [shape=doublecircle, xlabel="...same + _ASSIGN"];
  P1 [shape=doublecircle, xlabel="DOT"];
  P2 [shape=circle];
  P3 [shape=doublecircle, xlabel="ELLIPSIS"];
  S0 [shape=circle];
  X1 [shape=circle];
  X2 [shape=doublecircle, xlabel="NOT_EQUAL"];
  start -> S0;
  S0 -> L1 [label="<"];
  L1 -> L2 [label="="];
  L1 -> L3 [label="<"];
  L3 -> L4 [label="="];
  S0 -> M1 [label="*"];
  M1 -> M2 [label="*"];
  M1 -> M3 [label="="];
  M2 -> M4 [label="="];
  S0 -> E1 [label="="];
  E1 -> E2 [label="="];
  S0 -> X1 [label="!"];
  X1 -> X2 [label="="];
  S0 -> H1 [label="-"];
  H1 -> H2 [label="="];
  H1 -> H3 [label=">"];
  S0 -> P1 [label="."];
  P1 -> P2 [label="."];
  P2 -> P3 [label="."];
  S0 -> O1 [label="+, &, |, ^, %"];
  O1 -> O2 [label="="];
  S0 -> K1 [label="( ) [ ] { } , : ; ~ @"];
}