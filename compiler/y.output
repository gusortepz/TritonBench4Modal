Grammar

    0 $accept: program $end

    1 program: element program
    2        | /* empty */

    3 element: header
    4        | stmt

    5 header: IF test COLON
    6       | ELIF test COLON
    7       | ELSE COLON
    8       | WHILE test COLON
    9       | FOR exprlist IN testlist COLON
   10       | funcheader
   11       | decorator

   12 funcheader: DEF NAME parameters ret_annot COLON

   13 ret_annot: ARROW test
   14          | /* empty */

   15 decorator: AT dotted_name deco_args

   16 deco_args: OPEN_PARENTHESIS call_args CLOSE_PARENTHESIS
   17          | /* empty */

   18 parameters: OPEN_PARENTHESIS params CLOSE_PARENTHESIS

   19 params: paramlist
   20       | /* empty */

   21 paramlist: param paramlist_tail

   22 paramlist_tail: COMMA param_after_comma
   23               | /* empty */

   24 param_after_comma: param paramlist_tail
   25                  | /* empty */

   26 param: NAME param_tail

   27 param_tail: COLON test param_default
   28           | ASSIGN test
   29           | /* empty */

   30 param_default: ASSIGN test
   31              | /* empty */

   32 stmt: testlist assign_tail
   33     | RETURN return_tail
   34     | PASS
   35     | BREAK
   36     | CONTINUE
   37     | import_stmt
   38     | ASSERT test assert_tail
   39     | RAISE raise_tail
   40     | GLOBAL name_list
   41     | NONLOCAL name_list
   42     | DEL exprlist

   43 assign_tail: ASSIGN testlist eq_chain_tail
   44            | augassign testlist
   45            | /* empty */

   46 eq_chain_tail: ASSIGN testlist eq_chain_tail
   47              | /* empty */

   48 augassign: PLUS_ASSIGN
   49          | MINUS_ASSIGN
   50          | STAR_ASSIGN
   51          | SLASH_ASSIGN
   52          | DOUBLE_SLASH_ASSIGN
   53          | PERCENT_ASSIGN
   54          | DOUBLE_STAR_ASSIGN
   55          | AMPERSAND_ASSIGN
   56          | PIPE_ASSIGN
   57          | CARET_ASSIGN
   58          | LEFT_SHIFT_ASSIGN
   59          | RIGHT_SHIFT_ASSIGN

   60 return_tail: testlist
   61            | /* empty */

   62 assert_tail: COMMA test
   63            | /* empty */

   64 raise_tail: test
   65           | /* empty */

   66 name_list: NAME name_list_tail

   67 name_list_tail: COMMA NAME name_list_tail
   68               | /* empty */

   69 import_stmt: IMPORT dotted_as_names
   70            | FROM dotted_name IMPORT import_target

   71 import_target: STAR
   72              | name_as_names

   73 dotted_as_names: dotted_as_name dotted_as_names_tail

   74 dotted_as_names_tail: COMMA dotted_as_name dotted_as_names_tail
   75                     | /* empty */

   76 dotted_as_name: dotted_name as_opt

   77 name_as_names: name_as_name name_as_names_tail

   78 name_as_names_tail: COMMA name_as_name name_as_names_tail
   79                   | /* empty */

   80 name_as_name: NAME as_opt

   81 as_opt: AS NAME
   82       | /* empty */

   83 dotted_name: NAME dotted_name_tail

   84 dotted_name_tail: DOT NAME dotted_name_tail
   85                 | /* empty */

   86 test: or_test

   87 testlist: test testlist_tail

   88 testlist_tail: COMMA testlist_after_comma
   89              | /* empty */

   90 testlist_after_comma: test testlist_tail
   91                     | /* empty */

   92 exprlist: expr exprlist_tail

   93 exprlist_tail: COMMA exprlist_after_comma
   94              | /* empty */

   95 exprlist_after_comma: expr exprlist_tail
   96                     | /* empty */

   97 or_test: and_test or_tail

   98 or_tail: OR and_test or_tail
   99        | /* empty */

  100 and_test: not_test and_tail

  101 and_tail: AND not_test and_tail
  102         | /* empty */

  103 not_test: NOT not_test
  104         | comparison

  105 comparison: expr comp_tail

  106 comp_tail: comp_op expr comp_tail
  107          | /* empty */

  108 comp_op: LESS
  109        | LESS_EQUAL
  110        | GREATER
  111        | GREATER_EQUAL
  112        | EQUAL_EQUAL
  113        | NOT_EQUAL
  114        | IN
  115        | NOT IN
  116        | IS is_not_opt

  117 is_not_opt: NOT
  118           | /* empty */

  119 expr: xor_expr bitor_tail

  120 bitor_tail: PIPE xor_expr bitor_tail
  121           | /* empty */

  122 xor_expr: and_expr xor_tail

  123 xor_tail: CARET and_expr xor_tail
  124         | /* empty */

  125 and_expr: shift_expr bitand_tail

  126 bitand_tail: AMPERSAND shift_expr bitand_tail
  127            | /* empty */

  128 shift_expr: arith_expr shift_tail

  129 shift_tail: LEFT_SHIFT arith_expr shift_tail
  130           | RIGHT_SHIFT arith_expr shift_tail
  131           | /* empty */

  132 arith_expr: term arith_tail

  133 arith_tail: PLUS term arith_tail
  134           | MINUS term arith_tail
  135           | /* empty */

  136 term: factor term_tail

  137 term_tail: STAR factor term_tail
  138          | SLASH factor term_tail
  139          | DOUBLE_SLASH factor term_tail
  140          | PERCENT factor term_tail
  141          | AT factor term_tail
  142          | /* empty */

  143 factor: PLUS factor
  144       | MINUS factor
  145       | TILDE factor
  146       | power

  147 power: atom_expr power_tail

  148 power_tail: DOUBLE_STAR factor
  149           | /* empty */

  150 atom_expr: atom trailer_list

  151 trailer_list: trailer trailer_list
  152             | /* empty */

  153 trailer: OPEN_PARENTHESIS call_args CLOSE_PARENTHESIS
  154        | OPEN_BRACKET subscriptlist CLOSE_BRACKET
  155        | DOT NAME

  156 call_args: arglist
  157          | /* empty */

  158 atom: NAME
  159     | INTEGER
  160     | FLOAT
  161     | strings
  162     | TRUE
  163     | FALSE
  164     | NONE
  165     | ELLIPSIS
  166     | OPEN_PARENTHESIS paren_body CLOSE_PARENTHESIS
  167     | OPEN_BRACKET list_body CLOSE_BRACKET
  168     | OPEN_BRACE dict_body CLOSE_BRACE

  169 paren_body: testlist
  170           | /* empty */

  171 list_body: testlist
  172          | /* empty */

  173 dict_body: dict_items
  174          | /* empty */

  175 strings: STRING strings_tail

  176 strings_tail: STRING strings_tail
  177             | /* empty */

  178 dict_items: dict_item dict_items_tail

  179 dict_items_tail: COMMA dict_items_after_comma
  180                | /* empty */

  181 dict_items_after_comma: dict_item dict_items_tail
  182                       | /* empty */

  183 dict_item: test COLON test

  184 arglist: argument arglist_tail

  185 arglist_tail: COMMA arglist_after_comma
  186             | /* empty */

  187 arglist_after_comma: argument arglist_tail
  188                    | /* empty */

  189 argument: test kwarg_tail

  190 kwarg_tail: ASSIGN test
  191           | /* empty */

  192 subscriptlist: subscript subs_tail

  193 subs_tail: COMMA subs_after_comma
  194          | /* empty */

  195 subs_after_comma: subscript subs_tail
  196                 | /* empty */

  197 subscript: test subscript_tail
  198          | COLON slice_upper

  199 subscript_tail: COLON slice_upper
  200               | /* empty */

  201 slice_upper: test slice_step_opt
  202            | COLON step_opt
  203            | /* empty */

  204 slice_step_opt: COLON step_opt
  205               | /* empty */

  206 step_opt: test
  207         | /* empty */


